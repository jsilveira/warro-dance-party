# See https://help.github.com/ignore-files/ for more about ignoring files.

.idea/*
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Swap
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
tags
[._]*.un~

# Dependencies — workspaces produce a single root package-lock.json;
# child package-lock.json / bun.lock files should not be committed.
**/node_modules
server/package-lock.json
server/bun.lock
client-ui/package-lock.json
client-ui/bun.lock

# Client build output — generated on deploy, do not commit.
server/public/ui/
client-ui/dist/

# Env files
.env
.env.local
.env.*.local
